{
  "expo": {
    "name": "EKM Jutaru",
    "slug": "Jutaru-Control",
    "scheme": "ekmjutaru",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logojutraru.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logojutraru.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jorgepaz12.JutaruControl"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "0c176467-58aa-485a-bf9b-33e0639657a1"
      }
    },
    "owner": "jorgepaz12"
  }
}